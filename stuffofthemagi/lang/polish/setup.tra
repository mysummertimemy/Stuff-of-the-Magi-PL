@1001 = ~Stuff of the Magi mod do BG II, BG II EE i EET~
@1002 = ~Uzyj nowych, mniej przesadzonych przedmiotow ORAZ dodaj je do wyposazenia stworzen (zalecane)~
@1003 = ~Uzyj nowych, mniej przesadzonych przedmiotow ORAZ dodaj je do ekwipunku stworzen~
@1004 = ~Uzyj oryginalnych, przesadzonych przedmiotow ORAZ dodaj je do wyposazenia stworzen~
@1005 = ~Uzyj oryginalnych, przesadzonych przedmiotow ORAZ dodaj je do ekwipunku stworzen~

@1010 = ~Musisz miec zainstalowane BG II, BGT, BG II EE lub EET, by moc zainstalowac Stuff of the Magi.~// This mod is only compatible with BGII: ToB, BGT, BG2:EE and EET installations
//@1020 = ~Your SoD game needs to be modmerged before mods can be installed on this game. Check the readme for more information and a link to download the DLC Merger or Modmerge..~

